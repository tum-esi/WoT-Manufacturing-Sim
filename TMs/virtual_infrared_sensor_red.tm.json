        }
    ],
    "@type": "Thing",
    "title": "VirtualInfraredSensorRed",
    "id": "urn:dev:ops:32473-virtual-sensor-red",
    "description": "Infrared sensor for the detection of red objects (Virtual)",
    "security": "nosec_sc",
    "securityDefinitions": {
        "nosec_sc": {
            "scheme": "nosec"
        }
    },
    "robotBaseFrame": {
        "@type": "cell:Frame",
        "@id": "urn:dev:ops:32473-virtual-sensor-red#base",
        "cell:hasPose": {
