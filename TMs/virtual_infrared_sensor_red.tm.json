            "cell:referenceFrame": "cell:coppeliaSimWorld",
            "cell:position": {
                "@type": "cell:Position",
                "cell:x": 0,
                "cell:y": 0,
                "cell:z": 0
            },
            "cell:orientation": {
                "@type": "cell:Quaternion",
                "cell:qx": 0,
                "cell:qy": 0,
                "cell:qz": 0,
                "cell:qw": 1
            }
        }
    },
    "properties": {
        "status": {
            "title": "Device status",
            "description": "Operational health of the device. Possible status: operational, broken, error.",
