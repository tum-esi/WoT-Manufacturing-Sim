            "enum": ["operational", "broken", "error"],
            "readOnly": true,
            "observable": true
        },
        "objectPresence": {
            "title": "Read infrared sensor",
            "description": "get the sensor state if there is object",
            "type": "boolean",
            "readOnly": true,
            "observable": true
        }
